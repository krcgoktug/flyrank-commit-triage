# Copy to .env. Gitignored; nothing here is secret in the local default, but the shape is
# the same when you point it at a hosted provider.

# OpenAI-compatible base URL. Local Ollama by default - free, no card, works offline.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# The whole point of the timeout is that it is short enough to hurt.
LLM_TIMEOUT_SECONDS=25
LLM_MAX_ATTEMPTS=3
